 334 |     private void writeProjectIndex(String projectPath, Map<String, List<Map<String, Object>>> projectAnchors) throws IOException {
 335 |         Path projectDir = PathUtils.safeResolve(projectPath);
 336 |         Map<String, List<Map<String, Object>>> index = new LinkedHashMap<>();
 337 | 
 338 |         for (Map.Entry<String, List<Map<String, Object>>> e : projectAnchors.entrySet()) {
 339 |             String relPath = e.getKey();
 340 |             Path filePath = projectDir.resolve(relPath);
 341 |             List<Map<String, Object>> entries = buildIndexEntries(filePath, e.getValue());
 342 |             if (!entries.isEmpty()) index.put(relPath, entries);
 343 |         }
 344 | 
 345 |         Path indexFile = projectDir.resolve(PROJECT_INDEX_NAME);
 346 |         Files.writeString(indexFile,
 347 |                 objectMapper.writerWithDefaultPrettyPrinter().writeValueAsString(index));
