 249 |     private List<Map<String, Object>> buildIndexEntries(Path file, List<Map<String, Object>> anchors) {
 250 |         StructureParserRegistry registry = StructureParserRegistry.getInstance();
 251 |         List<MethodDefinition> methods = parseMethods(file, registry);
 252 |         List<Map<String, Object>> list = new ArrayList<>();
 253 |         for (Map<String, Object> a : anchors) {
 254 |             String id = (String) a.get("id");
 255 |             if (id != null && END_ANCHOR_PATTERN.matcher(id).find()) continue;
 256 |             Map<String, Object> m = new LinkedHashMap<>();
 257 |             m.put("id", id);
 258 |             m.put("line", a.get("line"));
 259 |             m.put("desc", a.getOrDefault("desc", ""));
 260 |             Object lineObj = a.get("line");
 261 |             if (lineObj instanceof Integer line) {
 262 |                 String symbol = findSymbolForAnchor(line, methods);
 263 |                 if (symbol != null && !symbol.isEmpty()) m.put("symbol", symbol);
 264 |             }
 265 |             list.add(m);
 266 |         }
 267 |         return list;
 268 |     }
