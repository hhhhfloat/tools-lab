 196 |     private List<Map<String, Object>> scanAnchorsFromFile(Path file) throws IOException {
 197 |         String fileName = file.getFileName().toString();
 198 |         String ext = "";
 199 |         int dotIdx = fileName.lastIndexOf('.');
 200 |         if (dotIdx > 0) ext = fileName.substring(dotIdx).toLowerCase();
 201 |         if (!TEXT_EXTENSIONS.contains(ext)) return List.of();
 202 | 
 203 |         List<String> lines = Files.readAllLines(file, StandardCharsets.UTF_8);
 204 |         List<Map<String, Object>> anchors = new ArrayList<>();
 205 |         Set<String> localSeen = new HashSet<>();   // ← 文件内去重
 206 |         for (int i = 0; i < lines.size(); i++) {
 207 |             java.util.regex.Matcher matcher = ANCHOR_PATTERN.matcher(lines.get(i));
 208 |             if (!matcher.find()) continue;
 209 |             String id = null;
 210 |             for (int j = 1; j <= matcher.groupCount(); j++) {
 211 |                 String c = matcher.group(j);
 212 |                 if (c != null) { id = c; break; }
 213 |             }
 214 |             if (id == null) continue;
 215 |             String finalId = id;
 216 |             int suffix = 2;
 217 |             while (localSeen.contains(finalId)) finalId = id + "_" + suffix++;
 218 |             localSeen.add(finalId);
 219 | 
 220 |             Map<String, Object> anchor = new LinkedHashMap<>();
 221 |             anchor.put("id", finalId);
 222 |             anchor.put("line", i + 1);
 223 |             anchor.put("preview", lines.get(i).trim());
 224 |             anchor.put("desc", extractDesc(lines, i));
 225 |             anchors.add(anchor);
 226 |         }
 227 |         return anchors;
 228 |     }
