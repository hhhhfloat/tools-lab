 230 |     // @anchor: anchorIndex_leanize
 231 |     // 将锚点列表精简为 id + line + preview（.anchors.json 专用格式）
 232 |     private Map<String, List<Map<String, Object>>> leanize(
 233 |             Map<String, List<Map<String, Object>>> projectAnchors) {
 234 |         Map<String, List<Map<String, Object>>> lean = new LinkedHashMap<>();
 235 |         for (Map.Entry<String, List<Map<String, Object>>> e : projectAnchors.entrySet()) {
 236 |             List<Map<String, Object>> list = new ArrayList<>();
 237 |             for (Map<String, Object> a : e.getValue()) {
 238 |                 Map<String, Object> m = new LinkedHashMap<>();
 239 |                 m.put("id", a.get("id"));
 240 |                 m.put("line", a.get("line"));
 241 |                 m.put("preview", a.get("preview"));
 242 |                 list.add(m);
 243 |             }
 244 |             lean.put(e.getKey(), list);
 245 |         }
 246 |         return lean;
 247 |     }
