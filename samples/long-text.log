 270 |     /**
 271 |      * 从锚点行的下一行开始，提取紧邻的注释作为描述。
 272 |      * 支持 //、#、/* * /、<!-- -->。
 273 |      * 取不到则返回空字符串。
 274 |      */
 275 |     private String extractDesc(List<String> lines, int anchorLineIdx) {
 276 |         int next = anchorLineIdx + 1;
 277 |         if (next >= lines.size()) return "";
 278 | 
 279 |         String line = lines.get(next).trim();
 280 | 
 281 |         // 不跳过空行——锚点后必须紧贴注释，否则视为无描述
 282 |         if (line.isEmpty()) return "";
 283 | 
 284 |         // 遇到下一个锚点行，说明本锚点无描述
 285 |         if (line.contains("@anchor:")) return "";
 286 | 
 287 |         // 单行注释
 288 |         if (line.startsWith("//")) {
 289 |             String content = line.substring(2).trim();
 290 |             return content.contains("@anchor:") ? "" : content;
 291 |         }
 292 |         if (line.startsWith("#") && !line.startsWith("#!")) {
 293 |             String content = line.substring(1).trim();
 294 |             return content.contains("@anchor:") ? "" : content;
 295 |         }
 296 | 
 297 |         // 块注释 /** ... */ 或 /* ... */
 298 |         if (line.startsWith("/**") || line.startsWith("/*")) {
 299 |             String rest = line.startsWith("/**") ? line.substring(3) : line.substring(2);
 300 |             rest = rest.trim();
 301 |             if (rest.endsWith("*/")) {
 302 |                 rest = rest.substring(0, rest.length() - 2).trim();
 303 |             }
 304 |             if (!rest.isEmpty()) return rest;
 305 | 
 306 |             // 块内后续行——允许块内跳空行，因为块注释本身是完整的语义单元
 307 |             for (int i = next + 1; i < lines.size(); i++) {
 308 |                 String l = lines.get(i).trim();
 309 |                 if (l.equals("*/") || l.equals("* /")) return "";
 310 |                 if (l.contains("@anchor:")) return "";
 311 |                 if (l.startsWith("*")) l = l.substring(1).trim();
 312 |                 if (l.endsWith("*/")) l = l.substring(0, l.length() - 2).trim();
 313 |                 if (!l.isEmpty()) return l;
 314 |             }
 315 |             return "";
 316 |         }
 317 | 
 318 |         // HTML 注释
 319 |         if (line.startsWith("<!--")) {
 320 |             String rest = line.substring(4).trim();
 321 |             if (rest.endsWith("-->")) {
 322 |                 rest = rest.substring(0, rest.length() - 3).trim();
 323 |             }
 324 |             return rest;
 325 |         }
 326 | 
 327 |         return "";
 328 |     }
