 152 |                     .filter(Files::isRegularFile)
 153 |                     .forEach(file -> {
 154 |                         String name = file.getFileName().toString();
 155 |                         if (name.equals(AgentConfig.getAnchorIndexName())) return;
 156 |                         if (name.equals(".anchor_index.json")) return;
 157 |                         if (name.equals(".agent_entry.json")) return;
 158 |                         if (name.startsWith(".")) return;
 159 | 
