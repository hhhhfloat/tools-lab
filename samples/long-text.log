 161 |                             Path relPath = projectDir.relativize(file);
 162 |                             if (relPath.getNameCount() > 0 && EXCLUDED_DIRS.contains(relPath.getName(0).toString())) return;
 163 | 
 164 |                             String rel = projectDir.relativize(file).toString().replace('\\', '/');
 165 |                             List<Map<String, Object>> anchors = scanAnchorsFromFile(file);
 166 |                             if (!anchors.isEmpty()) projectAnchors.put(rel, anchors);
 167 |                         } catch (IOException ignored) {}
 168 |                     });
